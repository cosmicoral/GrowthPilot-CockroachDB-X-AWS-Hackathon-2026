# Copy to .env and fill in real values. Never commit .env.
#
# CockroachDB Cloud — cluster `gtm-agent`, AWS eu-west-2, v26.2.1
# Get credentials from Coral. Before connecting for the first time you must
# download the CA certificate:
#
#   curl --create-dirs -o ~/.postgresql/root.crt \
#     'https://cockroachlabs.cloud/clusters/<cluster-id>/cert'
#
DATABASE_URL="postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full"
# Connection pool — optional, sensible defaults are in backend/database/config.py.
# Uncomment only to override. Rationale for these values is in docs/memory.md.
#
# DB_POOL_MIN_SIZE=2                          # warm connections kept open
# DB_POOL_MAX_SIZE=10                         # CockroachDB Serverless caps concurrency
# DB_COMMAND_TIMEOUT=10                       # seconds; fail rather than hang
# DB_MAX_INACTIVE_CONNECTION_LIFETIME=300     # seconds; CockroachDB Cloud drops idle conns
# AWS / Bedrock — us-east-1.
#
# Note this differs from the CockroachDB cluster region (eu-west-2, above).
# Bedrock on-demand quota is granted per-region, and this account has none in
# the EU: eu-west-2 and eu-west-3 both return ThrottlingException on every
# InvokeModel call, including a single cold request. us-east-1 serves both
# models normally. The cross-region hop costs ~100-150ms per embedding call,
# which is acceptable; losing inference entirely is not.
#
# Both model IDs are read here rather than hardcoded so the deployed service
# can be repointed without a code change.
#
# The text model must be the `us.` inference-profile ID, not the bare model
# ID: us-east-1 rejects `anthropic.claude-sonnet-4-6` with "Invocation of
# model ID ... with on-demand throughput isn't supported. Retry your request
# with the ID or ARN of an inference profile". The embedding model is a bare
# ID and needs no profile.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_TEXT_MODEL=us.anthropic.claude-sonnet-4-6

LOG_LEVEL=INFO

# Agent trace safety limits (optional)
TRACE_MAX_PAYLOAD_CHARS=20000
TRACE_MAX_STRING_CHARS=8000
TRACE_MAX_MEMORIES=20
# Authentication sessions. Cookies are Secure by default when this setting is
# absent. Set false only in a local HTTP .env; production must use HTTPS/true.
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Comma-separated exact origins; do not use * with cookie authentication.
FRONTEND_ORIGINS=http://localhost:5173

# --- Deployed environment only -------------------------------------------
# When the frontend and backend are on different sites (e.g. Vercel + Render),
# the session cookie must be SameSite=None and Secure, or every authenticated
# request after login fails with 401. Set FRONTEND_ORIGINS to the exact
# deployed frontend origin, no trailing slash:
#
#   FRONTEND_ORIGINS=https://<frontend-domain>
#   SESSION_COOKIE_SECURE=true
#   SESSION_COOKIE_SAMESITE=none
#
# Frontend build needs VITE_API_BASE_URL=https://<backend-domain> set in the
# frontend host's own environment, not here.

# Leave empty when using the local Vite proxy.
VITE_API_BASE_URL=

# For a separately deployed API:
# VITE_API_BASE_URL=https://api.example.com

# Replace this when the full chat frontend lands. The included /chat route is
# an authenticated handoff screen that verifies /api/company/me and supports logout.
VITE_CHAT_URL=/chat
